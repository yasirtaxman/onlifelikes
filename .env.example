# ─────────────────────────────────────────────────────────────
# On Life Likes — Environment variables
# Copy this file to .env.local and fill in your values.
# Anything left empty falls back to a safe default or is disabled.
# ─────────────────────────────────────────────────────────────

# Canonical site URL (no trailing slash). Used for sitemap, RSS, OG tags, canonical URLs.
NEXT_PUBLIC_SITE_URL=https://onlifelikes.com

# ── Sanity CMS ───────────────────────────────────────────────
# Create a free project at https://www.sanity.io/manage, then paste the
# project ID and dataset here. Until these are set, the site serves the
# built-in sample content so you can develop and preview everything.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01
# Optional: read token for previewing drafts (create in sanity.io/manage → API → Tokens)
SANITY_API_READ_TOKEN=

# ── Google AdSense ───────────────────────────────────────────
# Your publisher ID, e.g. ca-pub-1234567890123456
# Leave empty until AdSense approves your site; placeholders render instead.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Optional per-position slot IDs (from your AdSense dashboard)
NEXT_PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=

# ── Google Analytics (GA4) ───────────────────────────────────
# e.g. G-XXXXXXXXXX — leave empty to disable
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Privacy-friendly analytics (optional alternative to GA) ──
# Set your Plausible domain (e.g. onlifelikes.com) to enable Plausible instead
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Amazon Associates tracking IDs (one per marketplace) ─────
# Links automatically use the right tag for each store.
NEXT_PUBLIC_AMAZON_TAG_US=onlifelikes-20
NEXT_PUBLIC_AMAZON_TAG_UK=onlifelikes-21
NEXT_PUBLIC_AMAZON_TAG_CA=onlifelikesca-20
NEXT_PUBLIC_AMAZON_TAG_DE=onlifelikesde-21
NEXT_PUBLIC_AMAZON_TAG_FR=onlifelikesfr-21
NEXT_PUBLIC_AMAZON_TAG_ES=onlifelikeses-21
NEXT_PUBLIC_AMAZON_TAG_IT=onlifelikesit-21

# ── Newsletter (optional) ────────────────────────────────────
# Paste your provider's form action URL (Mailchimp, Buttondown, ConvertKit…)
NEXT_PUBLIC_NEWSLETTER_ACTION=
